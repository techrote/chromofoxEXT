{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Rescue (chromofoxEXT)",
  "version": "0.1.0",
  "description": "Explicit, bounded experiments to revive a stuck ChatGPT conversation without reading its content.",
  "permissions": ["activeTab"],
  "action": { "default_title": "Rescue stuck ChatGPT conversation", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["logic.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
