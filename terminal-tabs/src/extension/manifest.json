{
  "manifest_version": 2,
  "name": "chromofoxEXT Terminal Tabs (experimental)",
  "version": "0.1.0",
  "description": "Open real local Windows console sessions inside Firefox browser tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "terminal-tabs@chromofoxext.local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["protocol.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "New terminal tab",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "nativeMessaging"],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
